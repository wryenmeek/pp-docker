{
  "name": "pp-docker",
  "version": "0.1.0",
  "description": "Auto-containerize and register printing-press-library MCP servers into Docker Desktop",
  "license": "MIT",
  "author": "wryenmeek",
  "type": "module",
  "bin": {
    "pp-docker": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "imports": {
    "#*.js": "./src/*.ts",
    "#*": "./src/*"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text",
    "knip": "knip",
    "ci": "biome check . && tsc --noEmit && knip && bun test --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@biomejs/cli-darwin-arm64": "^2.5.12",
    "@types/bun": "^1.4.1",
    "@types/node": "^22.13.5",
    "knip": "^6.34.0",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "docker",
    "docker-desktop",
    "printing-press",
    "ai-agents"
  ]
}
